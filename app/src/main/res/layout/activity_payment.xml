<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:background="@color/background">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="24dp" android:background="@color/background">
        <com.google.android.material.button.MaterialButton android:id="@+id/back" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/back" android:layout_marginTop="8dp" style="@style/CineButton.Outline" android:layout_marginBottom="24dp" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/CineHeading" android:layout_marginBottom="12dp" android:text="@string/payment_heading" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/CineBody" android:layout_marginBottom="12dp" android:text="@string/payment_caption" />
        <TextView android:id="@+id/payment_showtime" android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/CineBody" android:layout_marginTop="12dp" android:layout_marginBottom="12dp" />
        <TextView android:id="@+id/payment_seats" android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/CineBody" android:layout_marginTop="20dp" android:layout_marginBottom="12dp" />
        <TextView android:id="@+id/payment_total" android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/CineHeading" android:layout_marginBottom="20dp" android:textSize="23sp" android:textColor="@color/lime" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/CineHeading" android:layout_marginBottom="8dp" android:text="@string/payment_method_heading" android:textSize="20sp" />
        <RadioGroup android:id="@+id/payment_methods" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
            <RadioButton android:id="@+id/method_card" android:layout_width="match_parent" android:layout_height="wrap_content" android:checked="true" android:padding="8dp" android:text="@string/method_card_demo" android:textColor="@color/text_primary" />
            <RadioButton android:id="@+id/method_momo" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="8dp" android:text="@string/method_momo_demo" android:textColor="@color/text_primary" />
            <RadioButton android:id="@+id/method_zalopay" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="8dp" android:text="@string/method_zalopay_demo" android:textColor="@color/text_primary" />
        </RadioGroup>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/CineBody" android:layout_marginTop="16dp" android:layout_marginBottom="16dp" android:text="@string/payment_demo_notice" android:textSize="12sp" />
        <com.google.android.material.button.MaterialButton android:id="@+id/confirm_payment" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/confirm_payment" android:layout_marginTop="8dp" />
        <com.google.android.material.button.MaterialButton android:id="@+id/simulate_failure" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/simulate_payment_failure" android:layout_marginTop="8dp" style="@style/CineButton.Outline" />
    </LinearLayout>
</ScrollView>
