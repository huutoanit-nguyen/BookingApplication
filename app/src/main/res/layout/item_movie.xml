        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/CineBody" android:layout_marginBottom="12dp" android:id="@+id/genre" android:textSize="11sp" android:maxLines="1" android:ellipsize="end" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/CineBody" android:layout_marginBottom="12dp" android:id="@+id/duration" android:textSize="11sp" android:textColor="@color/lime" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
