    <string name="movie_1_title">Dune: Hành tinh cát</string>
    <string name="movie_1_genre">Khoa học viễn tưởng</string>
    <string name="movie_1_director">Denis Villeneuve</string>
    <string name="movie_1_description">Paul Atreides cùng Chani và người Fremen bước vào hành trình chống lại những kẻ đã hủy hoại gia đình. Giữa tình yêu và vận mệnh vũ trụ, Paul phải ngăn chặn một tương lai mà chỉ mình anh có thể nhìn thấy.</string>
    <string name="movie_2_title">Thành phố không ngủ</string>
    <string name="movie_2_genre">Hành động · Tâm lý</string>
    <string name="movie_2_director">Nguyễn Minh Anh</string>
    <string name="movie_2_description">Một cuộc gặp gỡ tình cờ giữa lòng thành phố rực rỡ ánh đèn đưa hai người xa lạ vào hành trình tìm lại chính mình. Khi màn đêm buông xuống, mọi bí mật dần được hé lộ.</string>
    <string name="movie_3_title">Ánh sáng cuối chân trời</string>
    <string name="movie_3_genre">Phiêu lưu · Kỳ ảo</string>
    <string name="movie_3_director">Trần Hoàng Nam</string>
    <string name="movie_3_description">Trong thế giới đang mất dần ánh sáng, một nhóm bạn trẻ lên đường tìm kiếm nguồn năng lượng cuối cùng. Một câu chuyện về lòng dũng cảm, tình bạn và niềm hy vọng.</string>
    <string name="movie_4_title">Mật mã tương lai</string>
    <string name="movie_4_genre">Khoa học viễn tưởng</string>
    <string name="movie_4_director">Lê Quốc Huy</string>
    <string name="movie_4_description">Một lập trình viên phát hiện mật mã có thể thay đổi tương lai. Giữa thành phố công nghệ, anh phải lựa chọn giữa sự thật và sự an toàn của những người thân yêu.</string>
    <string name="movie_5_title">Phía sau ánh đèn</string>
    <string name="movie_5_genre">Tình cảm · Tâm lý</string>
    <string name="movie_5_director">Phạm Thu Hà</string>
    <string name="movie_5_description">Phía sau sự náo nhiệt của thành phố là những ước mơ bình dị. Một cô gái trẻ theo đuổi đam mê nghệ thuật và tìm thấy tình yêu ở nơi ít ngờ tới nhất.</string>
    <string name="movie_6_title">Chuyến xe cuối cùng</string>
    <string name="movie_6_genre">Hành động · Giật gân</string>
    <string name="movie_6_director">Vũ Đức Long</string>
    <string name="movie_6_description">Chuyến xe cuối cùng trong đêm trở thành cuộc đua với thời gian. Một tài xế bình thường phải vượt qua giới hạn để bảo vệ những hành khách xa lạ.</string>
