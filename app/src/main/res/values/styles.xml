<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.MovieTicket" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/lime</item>
        <item name="colorPrimaryVariant">@color/lime</item>
        <item name="colorOnPrimary">@color/on_lime</item>
        <item name="colorSecondary">@color/lime</item>
        <item name="colorOnSecondary">@color/on_lime</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorError">@color/error</item>
        <item name="android:colorBackground">@color/background</item>
        <item name="android:windowBackground">@color/background</item>
        <item name="android:statusBarColor">@color/background</item>
        <item name="android:navigationBarColor">@color/background</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:fontFamily">sans</item>
        <item name="android:windowSoftInputMode">adjustResize</item>
        <item name="materialButtonStyle">@style/CineButton</item>
        <item name="textInputStyle">@style/CineInput</item>
    </style>
    <style name="CineButton" parent="Widget.MaterialComponents.Button">
        <item name="cornerRadius">14dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">54dp</item>
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="backgroundTint">@color/lime</item>
        <item name="android:textColor">@color/on_lime</item>
    </style>
    <style name="CineButton.Outline" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="cornerRadius">14dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">52dp</item>
        <item name="strokeColor">@color/outline</item>
        <item name="android:textColor">@color/lime</item>
    </style>
    <style name="CineInput" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxBackgroundColor">@color/surface_input</item>
        <item name="boxStrokeColor">@color/text_secondary</item>
        <item name="hintTextColor">@color/lime</item>
        <item name="android:textColorHint">@color/text_secondary</item>
        <item name="boxCornerRadiusTopStart">12dp</item>
        <item name="boxCornerRadiusTopEnd">12dp</item>
        <item name="boxCornerRadiusBottomStart">12dp</item>
        <item name="boxCornerRadiusBottomEnd">12dp</item>
    </style>
    <style name="CineHeading">
        <item name="android:textSize">30sp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">-0.03</item>
    </style>
    <style name="CineBody">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:lineSpacingExtra">5dp</item>
    </style>
</resources>
